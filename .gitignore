# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# =========================================================
# 🔧 DEPENDENCIES
# =========================================================
/node_modules
/backend/node_modules
/frontend/node_modules
/.pnp
.pnp.js

# =========================================================
# 🧪 TESTING / COVERAGE
# =========================================================
/coverage
/backend/coverage
/frontend/coverage

# =========================================================
# 🏗️ BUILD / DIST
# =========================================================
/build
/dist
/dev-dist
/frontend/dist
/frontend/dev-dist
/frontend/.vite
/backend/.cache

# =========================================================
# 🧰 ENVIRONMENT FILES (keep only examples)
# =========================================================
.env
.env.bak
.env.local
.env.development.local
.env.test.local
.env.production.local
/frontend/.env
/backend/.env
!backend/env.example

# =========================================================
# 🪣 BACKUPS / TEMP
# =========================================================
.backup-lexi/
RESTRUCTURE-SUMMARY.md

# =========================================================
# ⚙️ LOGS
# =========================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================================================
# 🧭 OS & EDITOR
# =========================================================
.DS_Store
Thumbs.db
.vscode/*
!.vscode/tasks.json     # خليه مفيد للمشروع
!.vscode/settings.json  # اختيارياً لو بتستخدمي إعدادات مشتركة

# =========================================================
# 🌐 FRONTEND (Vite / React)
# =========================================================
frontend/.cache
frontend/*.local
frontend/sw.js
frontend/workbox-*.js

# =========================================================
# 🧩 BACKEND
# =========================================================
backend/*.local
backend/*.sqlite
backend/*.db
backend/docker-data
backend/docker-compose.override.yml
