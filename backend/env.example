# ========= FRONTEND / APIs =========
REACT_APP_ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_BASE=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ========= CLERK =========
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUD=http://localhost:5173

# ========= DATABASE =========
# الخيار السريع: سطر واحد
DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@127.0.0.1:5433/<DB_NAME>

# أو لو حابة تستخدمي الطريقة المفصّلة
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=
DB_PASSWORD=
DB_NAME=

DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=2000
DB_LOG_QUERIES=false

# ========= SERVER =========
PORT=3001
NODE_ENV=development

# ========= RATE LIMIT (اختياري) =========
RATE_LIMIT_WINDOW_MS=900000     # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:5173
