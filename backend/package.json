{
  "name": "lexi-learn-backend",
  "version": "1.0.0",
  "description": "LexiLearn Backend API with Clean Architecture",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seed.js",
    "seed:lessons": "node src/database/seed.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "setup": "npm install && cp env.example .env",
    "start:dev": "npm run setup && npm run docker:up"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "joi": "^17.11.0",
    "express-rate-limit": "^7.1.5",
    "compression": "^1.7.4",
    "@clerk/backend": "^1.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.8"
  },
  "keywords": [
    "lexi-learn",
    "language-learning",
    "api",
    "nodejs",
    "postgresql"
  ],
  "author": "LexiLearn Team",
  "license": "MIT"
}